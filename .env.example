APP_NAME=Sicode
SICODE_RULESET=es
SICODE_DISPLAY_NAME=sicodeES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_QA=false
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000

LEGAL_PII_HASH_KEY=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# API de FERIADO NACIONAL - Atualiza o calendário de feriados nacionais e estaduais.
# ==============================================================================
FERIADOS_API_URL=https://feriadosapi.com
FERIADOS_API_KEY=

# ==============================================================================
# DATABASE PRINCIPAL - MariaDB local via Docker tools_mariadb
# Neste setup, app e banco estão em redes Docker diferentes.
# Usar host.docker.internal (gateway do host com portas publicadas).
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=sicode
DB_USERNAME=sicode
DB_PASSWORD=

# ==============================================================================
# DATABASE ORIGEM - SQL Server via portproxy/gateway WSL
# Mantido em 172.23.64.1 quando o portproxy Windows aponta para esse gateway.
# ==============================================================================
DB1_CONNECTION=sqlsrv1
DB1_HOST=172.23.64.1
DB1_PORT=63918
DB1_DATABASE=edp-depc
DB1_USERNAME=
DB1_PASSWORD=

DB2_CONNECTION=sqlsrv2
DB2_HOST=172.23.64.1
DB2_PORT=63918
DB2_DATABASE=sicode
DB2_USERNAME=
DB2_PASSWORD=

# ==============================================================================
# BROADCAST / CACHE / FILAS / SESSION
# Octane nao precisa de Reverb.
# Redis pode ser usado para fila/cache.
# ==============================================================================
BROADCAST_DRIVER=log

CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_COOKIE=sicode_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local

# ==============================================================================
# REDIS neste setup também via host gateway
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=sicode2_

# ==============================================================================
# MEMCACHED
# ==============================================================================
MEMCACHED_HOST=127.0.0.1

# ==============================================================================
# OCTANE / SWOOLE
# ==============================================================================
OCTANE_SERVER=swoole
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8080
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500

# ==============================================================================
# MAIL
# Se voce nao tem mailpit rodando em container, deixe log.
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# STORAGE S3 / MINIO - ainda desativado
# Quando usar MinIO, preencher endpoint, bucket e credenciais.
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# PUSHER / REVERB - nao usado agora
# ==============================================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=localhost
PUSHER_PORT=8080
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ==============================================================================
# VITE
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_DEV_SERVER_URL=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
